<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppRoot>$(MSBuildProjectDirectory)\ClientApp\</ClientAppRoot>
  </PropertyGroup>

  <ItemGroup>
    <ClientAppSource Include="$(ClientAppRoot)src\**\*;$(ClientAppRoot)index.html;$(ClientAppRoot)package.json;$(ClientAppRoot)package-lock.json;$(ClientAppRoot)tsconfig.json;$(ClientAppRoot)vite.config.ts" />
    <Content Remove="wwwroot\index.html;wwwroot\assets\**\*" />
    <Content Include="wwwroot\index.html"
             Link="wwwroot\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot\assets\**\*"
             Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildClientApp"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SkipClientBuild)' != 'true'"
          Inputs="@(ClientAppSource)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppRoot)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\IndustrialSim.Hosting\IndustrialSim.Hosting.csproj" />
    <ProjectReference Include="..\IndustrialSim.Application\IndustrialSim.Application.csproj" />
    <ProjectReference Include="..\IndustrialSim.Persistence\IndustrialSim.Persistence.csproj" />
    <ProjectReference Include="..\IndustrialSim.Templates\IndustrialSim.Templates.csproj" />
    <ProjectReference Include="..\IndustrialSim.Observability\IndustrialSim.Observability.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IndustrialSim.Core\IndustrialSim.Core.csproj" />
    <ProjectReference Include="..\IndustrialSim.Runtime\IndustrialSim.Runtime.csproj" />
    <ProjectReference Include="..\IndustrialSim.Devices\IndustrialSim.Devices.csproj" />
    <ProjectReference Include="..\IndustrialSim.Scenarios\IndustrialSim.Scenarios.csproj" />
    <ProjectReference Include="..\IndustrialSim.Faults\IndustrialSim.Faults.csproj" />
    <ProjectReference Include="..\IndustrialSim.Configuration\IndustrialSim.Configuration.csproj" />
    <ProjectReference Include="..\IndustrialSim.Protocols.Abstractions\IndustrialSim.Protocols.Abstractions.csproj" />
    <ProjectReference Include="..\IndustrialSim.Protocols.OpcUa\IndustrialSim.Protocols.OpcUa.csproj" />
    <ProjectReference Include="..\IndustrialSim.Protocols.Modbus\IndustrialSim.Protocols.Modbus.csproj" />
  </ItemGroup>

</Project>
